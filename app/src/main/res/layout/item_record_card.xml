<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Record Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvRecordEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏅"
                android:textSize="20sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvRecordTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Record Title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_200"
            android:layout_marginBottom="10dp" />

        <!-- Top Record Holder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Gold medal badge -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🥇"
                android:textSize="20sp"
                android:layout_marginEnd="10dp" />

            <!-- Holder info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRecordHolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Holder Name"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvRecordDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="vs Team • Match 1"
                    android:textSize="12sp"
                    android:textColor="@color/gray_600"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Record value badge -->
            <TextView
                android:id="@+id/tvRecordValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/purple_700"
                android:background="@drawable/bg_stat_value"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- View All Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAllRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW FULL LEADERBOARD"
            style="@style/Widget.Material3.Button.TextButton"
            android:textSize="11sp"
            android:textAllCaps="true"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/purple_500" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
