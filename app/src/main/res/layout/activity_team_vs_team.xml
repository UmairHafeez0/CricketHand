<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_50">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_700"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_right"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── VS Hero Card ─────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/purple_700">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Teams Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvTeam1Emoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏏"
                                android:textSize="32sp" />

                            <TextView
                                android:id="@+id/tvTeam1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team A"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:id="@+id/tvTeam1Wins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0W"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#A5F3A5"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VS"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#CCFFFFFF"
                                android:background="#44FFFFFF"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp" />

                            <TextView
                                android:id="@+id/tvTotalMatches"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Matches"
                                android:textSize="11sp"
                                android:textColor="#99FFFFFF"
                                android:layout_marginTop="8dp"
                                android:gravity="center" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvTeam2Emoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏏"
                                android:textSize="32sp" />

                            <TextView
                                android:id="@+id/tvTeam2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team B"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_marginTop="6dp" />

                            <TextView
                                android:id="@+id/tvTeam2Wins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0W"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#A5C8F3"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Series leader badge -->
                    <TextView
                        android:id="@+id/tvSeriesLeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏅 Series tied"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:background="#33FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Side-by-Side Comparison Card ────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 COMPARISON"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="10dp" />

                    <!-- Column headers -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tvCompHeader1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="Team A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple_500"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="STAT"
                            android:textSize="11sp"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvCompHeader2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="Team B"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple_500"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/containerComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Match History Card ────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🕰 MATCH HISTORY"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/containerMatchHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvNoMatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No matches played between these teams"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Top Batsmen in H2H Card ────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏏 TOP BATSMEN IN THIS FIXTURE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginBottom="2dp" />

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="PLAYER"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RUNS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AVG"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SR"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/containerTopBatsmen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Top Bowlers in H2H Card ───────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎯 TOP BOWLERS IN THIS FIXTURE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginBottom="2dp" />

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="PLAYER"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="WKT"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RUNS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ECON"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_500"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/containerTopBowlers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Players to Watch Card ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/gold_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⭐ PLAYERS TO WATCH"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Team 1 key player -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#33FFFFFF"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/tvWatch1TeamLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team A"
                                android:textSize="10sp"
                                android:textColor="#CCFFFFFF"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvWatch1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvWatch1Stat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <!-- Team 2 key player -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#33FFFFFF"
                            android:padding="12dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:id="@+id/tvWatch2TeamLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team B"
                                android:textSize="10sp"
                                android:textColor="#CCFFFFFF"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvWatch2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="–"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvWatch2Stat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
