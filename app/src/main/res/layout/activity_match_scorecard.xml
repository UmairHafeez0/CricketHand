<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_50">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_700"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_right"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── Match Result Header ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/purple_700">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Team 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvTeam1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team 1"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvTeam1Score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/0"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvTeam1Overs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(0 ov)"
                                android:textSize="11sp"
                                android:textColor="#CCFFFFFF"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- VS divider -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vs"
                            android:textSize="12sp"
                            android:textColor="#AAFFFFFF"
                            android:paddingHorizontal="12dp" />

                        <!-- Team 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvTeam2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team 2"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvTeam2Score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/0"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvTeam2Overs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(0 ov)"
                                android:textSize="11sp"
                                android:textColor="#CCFFFFFF"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Winner badge -->
                    <TextView
                        android:id="@+id/tvWinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Result"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:background="#33FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="5dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Team 1 Batting Card ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBatting1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏏 TEAM 1 BATTING"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="6dp" />

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="BATTER"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="R"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="B"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="4s"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="6s"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="SR"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="end" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_200" android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/containerBatting1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Team 2 Bowling Card ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBowling2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎯 TEAM 2 BOWLING"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="6dp" />

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="BOWLER"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="OV"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="R"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="W"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="ECON"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="end" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_200" android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/containerBowling2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Innings divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="@color/purple_200" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  2nd Innings  "
                    android:textSize="11sp"
                    android:textColor="@color/purple_500"
                    android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="@color/purple_200" />

            </LinearLayout>

            <!-- ── Team 2 Batting Card ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBatting2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏏 TEAM 2 BATTING"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="6dp" />

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="BATTER"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="R"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="B"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="4s"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="6s"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="SR"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="end" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_200" android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/containerBatting2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Team 1 Bowling Card ─────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBowling1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎯 TEAM 1 BOWLING"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="6dp" />

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="BOWLER"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="OV"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="R"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="W"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="ECON"
                            android:textSize="10sp" android:textStyle="bold" android:textColor="@color/gray_500" android:gravity="end" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/gray_200" android:layout_marginBottom="2dp" />

                    <LinearLayout
                        android:id="@+id/containerBowling1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
